# ── Connection mode ───────────────────────────────────────────
# "ssh" หรือ "direct"
DB_CONNECTION_MODE=ssh

# ── SSH settings (ใช้เมื่อ DB_CONNECTION_MODE=ssh) ────────────
SSH_HOST=xxx.xxx.xx.x
SSH_PORT=22
SSH_USERNAME=your_ssh_user
SSH_PASSWORD=your_ssh_password
# ถ้าใช้ private key แทน password ให้กรอก SSH_PKEY (path ไปยังไฟล์ key)
# SSH_PKEY=/path/to/private_key
# SSH_PKEY_PASSWORD=key_passphrase

# ── PostgreSQL settings ────────────────────────────────────────
# สำหรับ SSH: host/port ของ DB ที่มองจาก SSH server
# สำหรับ direct: host/port ของ DB โดยตรง
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ic_finance

# ── Optional tuning ───────────────────────────────────────────
DB_CONNECT_TIMEOUT=10
DB_APP_NAME=python-client
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=5
