# ── Connection mode ───────────────────────────────────────────
# "ssh" หรือ "direct"
DB_CONNECTION_MODE=ssh

# ── SSH settings (ใช้เมื่อ DB_CONNECTION_MODE=ssh) ────────────
SSH_HOST=xxx.xxx.xx.x
SSH_PORT=22
SSH_USERNAME=your_ssh_user
SSH_PASSWORD=your_ssh_password
# ถ้าใช้ private key แทน password ให้กรอก SSH_PKEY (path ไปยังไฟล์ key)
# SSH_PKEY=/path/to/private_key
# SSH_PKEY_PASSWORD=key_passphrase

# ── PostgreSQL settings ────────────────────────────────────────
# สำหรับ SSH: host/port ของ DB ที่มองจาก SSH server
# สำหรับ direct: host/port ของ DB โดยตรง
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ic_finance

# ── Optional tuning ───────────────────────────────────────────
DB_CONNECT_TIMEOUT=10
DB_APP_NAME=python-client
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=5

# ── App metadata ──────────────────────────────────────────────
CREATED_BY=juntima

# ══════════════════════════════════════════════════════════════
# Research module
# ══════════════════════════════════════════════════════════════

# ── MSSQL — Research database (publication + track_evaluation) ─
LOCAL_HOST=localhost
LOCAL_USERNAME=your_mssql_user
LOCAL_PASSWORD=your_mssql_password
RESEARCH_DATABASE=your_research_db_name

# Schema ที่ใช้ใน MSSQL
SCHEMA_DEFAULT=dbo

# ชื่อตาราง MSSQL
PUBLICATION_TABLE=publications
TRACK_EVALUATION=track_evaluation

# ── Google Cloud (BigQuery) ────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account_key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_ID=Research

# ชื่อตาราง BigQuery — Publication (มีค่า default ถ้าไม่กำหนด)
GCP_PUBLICATION_STAGING_TABLE=publication_staging
GCP_PUBLICATION_TABLE_NAME=publications

# ชื่อตาราง BigQuery — Track Evaluation (มีค่า default ถ้าไม่กำหนด)
GCP_TRACK_EVAL_STAGING_TABLE=track_evaluation_staging
GCP_TRACK_EVAL_TABLE_NAME=track_evaluation

# ── Upload control flags ───────────────────────────────────────
# default = false → ไม่ upload ไปยัง DB หรือ BQ
# ตั้งเป็น true เมื่อต้องการ insert/update จริง
PUBLICATION_UPLOAD_MSSQL=false
PUBLICATION_UPLOAD_BQ=false
TRACK_EVAL_UPLOAD_MSSQL=false
TRACK_EVAL_UPLOAD_BQ=false

# ══════════════════════════════════════════════════════════════
# Zeal Data module  (src/aditayathorn/zeal_data)
# ══════════════════════════════════════════════════════════════

# path ไปยัง Data.mdb (relative จาก project root หรือ absolute)
ZEAL_MDB_PATH=data/aditayathorn/zeal_data/raw/Data.mdb

# ชื่อ PostgreSQL database ปลายทาง (ใช้ DB_HOST/PORT/USERNAME/PASSWORD เดิม)
ZEAL_DB_NAME=your_zeal_db_name

# schema ใน PostgreSQL (default: public)
ZEAL_SCHEMA=public

# replace = ลบตารางเก่าแล้วสร้างใหม่, append = เพิ่มข้อมูลต่อ
ZEAL_INSERT_MODE=replace
